{
  "manifest_version": 3,
  "name": "Dice Controller v3.0",
  "version": "3.0",
  "description": "Silent override Google Dice Roller — controlled from dashboard",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/search*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "icons": {}
}